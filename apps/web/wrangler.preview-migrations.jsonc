// Applies /migrations to the database Worker Previews use (Cloudflare's pattern for Previews):
//   npx wrangler d1 migrations apply DB --remote --config wrangler.preview-migrations.jsonc
// It must point at the same database as `previews.d1_databases` in wrangler.jsonc.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "energy-panel",
  "compatibility_date": "2026-09-30",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "energy-panel-preview",
      "database_id": "1166ce38-9f7e-44ec-aef2-d352a9b87abc",
      "migrations_dir": "../../migrations",
    },
  ],
}
