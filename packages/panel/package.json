{
  "name": "@energy-panel/panel",
  "version": "0.1.0",
  "private": true,
  "description": "Pure functions that compute and render the FSANZ energy statement as outlined SVG.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "glyphs:build": "node --experimental-strip-types scripts/build-glyphs.ts",
    "glyphs:check": "node --experimental-strip-types scripts/build-glyphs.ts --check",
    "fixtures:update": "node --experimental-strip-types scripts/update-fixtures.ts",
    "pdf:check": "node --experimental-strip-types scripts/check-pdfs.ts"
  },
  "dependencies": {
    "@energy-panel/rules": "workspace:*",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "opentype.js": "^2.0.0"
  }
}
