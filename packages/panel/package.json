{
  "name": "@energy-panel/panel",
  "version": "0.1.0",
  "private": true,
  "description": "Pure functions that compute the FSANZ energy statement and render it as outlined SVG, PDF, proof sheets and watermarked previews.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./settings": "./src/settings.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "glyphs:build": "node --experimental-strip-types scripts/build-glyphs.ts",
    "glyphs:check": "node --experimental-strip-types scripts/build-glyphs.ts --check",
    "fixtures:update": "node --experimental-strip-types scripts/update-fixtures.ts",
    "pdf:check": "node --experimental-strip-types scripts/check-pdfs.ts"
  },
  "dependencies": {
    "@energy-panel/rules": "workspace:*",
    "pdf-lib": "1.17.1",
    "pako": "1.0.11"
  },
  "devDependencies": {
    "opentype.js": "^2.0.0",
    "@types/pako": "1.0.7"
  }
}
